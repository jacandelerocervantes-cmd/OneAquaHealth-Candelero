# Server-side variables of the web app (names only; never put a real key in this file).
# Copy the names into the local environment file that Next.js reads, or into the Vercel project settings.

# "mock" (default): simulated responses that follow docs/openapi.json. "real": forward to the backend.
OAH_DATA_MODE=mock

# Real mode only. Backend origin, for example the Cloud Run service URL. No credentials, no query.
OAH_BACKEND_URL=

# Real mode only. The shared access key, set as a secret in the hosting settings. Leave empty here.
OAH_API_KEY=
