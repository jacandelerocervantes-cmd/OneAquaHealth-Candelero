# OneAquaHealth backend settings. Copy this file to .env (never versioned) and fill in what you need.
# Every line below is commented out except the two secrets: an unset variable uses the default shown.
# Do NOT leave a numeric, URL or path variable with an empty value ("NAME="): the server stops at start-up
# when it reads an empty number or URL. Either remove the "#" and give a real value, or leave the line commented.
# Never put real values in this example file.

# --- Secrets (real values only in .env, or in Secret Manager when deployed) ---------------------------------
ANTHROPIC_API_KEY=
OAH_API_KEY=

# --- Models and language --------------------------------------------------------------------------------------
# OAH_LLM_MODEL=claude-sonnet-5-5
# Translation model; unset means the same model as OAH_LLM_MODEL.
# OAH_TRANSLATION_MODEL=
# OAH_TRANSLATION_TIMEOUT_SECONDS=30
# Answer language when a request names none (a code listed by GET /languages, for example en or es-MX).
# OAH_DEFAULT_LANGUAGE=en

# --- API behaviour --------------------------------------------------------------------------------------------
# Comma-separated explicit origins allowed by CORS (a wildcard is refused).
# OAH_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173
# General per-client limit.
# OAH_RATE_LIMIT_MAX_REQUESTS=60
# OAH_RATE_LIMIT_WINDOW_SECONDS=60
# Comma-separated IP addresses of reverse proxies whose X-Forwarded-For header is believed. Leave unset on Cloud Run.
# OAH_TRUSTED_PROXIES=
# Set to 1 to expose the interactive API docs and the OpenAPI route (off by default).
# OAH_ENABLE_DOCS=0
# Test only. NEVER set this on a reachable host: it disables the access key check.
# OAH_INSECURE_NO_AUTH=0

# --- Sandbox cache -------------------------------------------------------------------------------------------
# Seconds a cached copy of the public sandbox is served as current (default 300).
# OAH_SANDBOX_CACHE_TTL_SECONDS=300
# Seconds a stale copy may still be served while a refresh runs (default 21600 = 6 h, at least the TTL).
# OAH_SANDBOX_MAX_STALE_SECONDS=21600
# Warm the cache at start-up: 1 (default) or 0 to disable, for offline development.
# OAH_SANDBOX_WARMUP=1

# --- Model spend controls (process-wide) ----------------------------------------------------------------------
# OAH_EXPLAIN_RATE_LIMIT_PER_MINUTE=5
# OAH_EXPLAIN_DAILY_CAP=100
# OAH_EXPLAIN_CACHE_TTL_SECONDS=600
# Chat: conversations per rolling 24 hours, per-minute limit, model calls per conversation (ceiling 8), seconds (ceiling 120).
# OAH_CHAT_DAILY_CAP=100
# OAH_CHAT_RATE_LIMIT_PER_MINUTE=5
# OAH_CHAT_MAX_STEPS=6
# OAH_CHAT_TIMEOUT_SECONDS=45

# --- External context: Open-Meteo, GloFAS and GBIF (optional, see docs/external_context.md) ------------------
# OAH_EXTERNAL_ENABLED=true is the master switch; false turns every provider off and the rest keeps working.
# OAH_EXTERNAL_ENABLED=true
# OAH_EXTERNAL_OPEN_METEO_ENABLED=true
# OAH_EXTERNAL_GLOFAS_ENABLED=true
# OAH_EXTERNAL_GBIF_ENABLED=true
# A plain https contact page of the operator (no credentials, query or fragment, at most 200 characters).
# It goes into the User-Agent sent to the providers. Never a personal e-mail address.
# OAH_CONTACT_URL=https://example.org/contact
# Seconds (default 8, ceiling 20), cache lifetime in seconds (default 3600), cache entries (default 256, ceiling 2048).
# OAH_EXTERNAL_TIMEOUT_SECONDS=8
# OAH_EXTERNAL_CACHE_TTL_SECONDS=3600
# OAH_EXTERNAL_CACHE_SIZE=256
# Budgets: Open-Meteo in estimated call units, GBIF in requests.
# OAH_EXTERNAL_OPEN_METEO_PER_MINUTE=200
# OAH_EXTERNAL_OPEN_METEO_DAILY=3000
# OAH_EXTERNAL_GBIF_PER_MINUTE=30
# OAH_EXTERNAL_GBIF_DAILY=1500

# --- Data locations (absolute paths only; keep them outside the repository) ----------------------------------
# Sandbox data, caches and runtime files. Default: a folder under your user data area, outside the project.
# OAH_DATA_DIR=
# Root against which the external origins listed in SOURCES.yaml are expressed.
# OAH_SOURCES_ROOT=
# Folder with the FHIR build and validator tools (only the IG scripts use it, see docs/environment_setup.md).
# OAH_TOOLS_DIR=
# JSON file that overrides limit values (format: docs/limits_override.example.json). Reloaded when it changes.
# OAH_LIMITS_FILE=
# Public HL7 Europe sandbox (https only, or http for localhost). Leave unset for the default.
# OAH_SANDBOX_URL=https://sandbox.hl7europe.eu/oneaquahealth/fhir
# Prebuilt SQLite stores (override only if you keep them somewhere other than the default under OAH_DATA_DIR).
# OAH_WATERBASE_STORE=
# OAH_BATHING_WATER_STORE=
# OAH_BATHING_SAMPLES_STORE=
# 7-Zip executable, needed only to REBUILD the Waterbase store (scripts/build_waterbase_store.py).
# OAH_SEVENZIP_PATH=
# OAH_ENABLE_WRITE_ROUTES=1
# OAH_TRUSTED_PROXY_HOPS=1